#Port to listen
PORT=3000

#Debug level
LOGGER_LEVEL=info

# Put your JWT secret here
JWT_SECRET=

#Timeout, in milliseconds, to expire the session and the cart
CART_EXPIRATION_TIME=7200000 #2 hours

DATABASE_URL=postgres://postgres:postgres@localhost:5432/shoppingcart
REDIS_URL=redis://localhost:6379

#Configuration for Open Telemetry
OTEL_SERVICE_NAME=shoppingcart
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT="https://api.honeycomb.io"
OTEL_EXPORTER_OTLP_HEADERS="x-honeycomb-team=5PjY4d87kZQuTZbNBBHQhA"